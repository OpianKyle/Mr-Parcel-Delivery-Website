modules = ["nodejs-24"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Mr Parcel Website"

[[workflows.workflow]]
name = "Mr Parcel Website"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Mr-Parcel-Delivery-Website/Mr-Parcel-Delivery-Website && (PORT=8080 pnpm --filter @workspace/api-server run dev &) && PORT=5000 BASE_PATH=/ pnpm --filter @workspace/mr-parcel run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080
